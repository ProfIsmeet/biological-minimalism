# Copy to .env.local to override. Defaults already point at the local backend.
#
# NEXT_PUBLIC_* values are PUBLIC browser configuration: Next.js inlines them
# into the client bundle at BUILD time, so they are visible to anyone who loads
# the page. Never put a secret in a NEXT_PUBLIC_* variable. For a containerized
# build these must be passed as build args (see docker-compose.yml and
# frontend/Dockerfile), not merely as runtime environment variables.

# REST API origin the browser calls. Must be reachable FROM the user's browser
# (not from inside a container). Local default:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Live-feed WebSocket URL. If left unset/empty it is derived from
# NEXT_PUBLIC_API_BASE_URL: http -> ws, https -> wss, with /ws/live-feed
# appended (a trailing slash on the API URL is trimmed first). Set it
# explicitly only when the WS endpoint is not a simple transform of the API
# origin. Local default:
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-feed

# --- Non-local deployment example (the browser must be able to reach these) ---
# NEXT_PUBLIC_API_BASE_URL=https://demo.example.org
# NEXT_PUBLIC_WS_URL=wss://demo.example.org/ws/live-feed
# The backend must also allow this browser origin via BIOMIN_ALLOWED_ORIGINS
# (see backend/.env.example and docs/JURY_DEPLOYMENT_RUNBOOK.md).
