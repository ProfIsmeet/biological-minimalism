# Copy to .env to override defaults. All variables are prefixed BIOMIN_.

BIOMIN_TICK_INTERVAL_SECONDS=0.5
BIOMIN_ROLLING_HISTORY_LENGTH=600
BIOMIN_MODEL_CHECKPOINT_PATH=
BIOMIN_SHAP_BACKGROUND_SAMPLES=80
BIOMIN_RANDOM_SEED=42

# CORS — exact browser origins allowed to call this API, as a JSON array.
# When unset the defaults are http://localhost:3000 and http://127.0.0.1:3000,
# which match the local demo frontend. Set this explicitly for any non-local
# host. Entries must be exact origins (scheme://host[:port]); '*' is rejected
# because credentials are enabled, and a value that is not a JSON list fails
# fast at startup rather than silently widening access. This is the allowed
# *browser origin* list — it is NOT the frontend's URL and NOT the backend's
# bind address.
# BIOMIN_ALLOWED_ORIGINS=["https://demo.example.org","https://demo2.example.org"]
# Official PPG-DaLiA outer zip or an extracted PPG_FieldStudy directory.
BIOMIN_PPG_DALIA_PATH=
# Validated PPG-DaLiA Model B checkpoint (SHA256 is enforced by the bridge).
BIOMIN_PPG_DALIA_HR_CHECKPOINT_PATH=../ml/checkpoints/model_b_ppg_plus_imu_ppg_dalia.pt
