# --- Python / backend ---
.venv/
.venv-integration/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env

# --- Node / frontend ---
node_modules/
.next/
out/
frontend/.env*.local

# --- ML checkpoints & datasets (large binaries, not committed) ---
ml/checkpoints/*
!ml/checkpoints/.gitkeep
datasets/*/*
!datasets/*/README.md
datasets/**/*.pkl
datasets/**/*.h5
datasets/**/*.npz
datasets/**/*.zip
datasets/**/raw/
datasets/**/raw_uci/
datasets/**/processed/

# --- Local checkpoint archival packages (large binaries, not committed - see
# results/checkpoint_archival_verification.json for the manifest/hashes) ---
archival/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Agent/tooling scratch & unrelated working data (never commit) ---
.work/
.codex_tmp/
outputs/
